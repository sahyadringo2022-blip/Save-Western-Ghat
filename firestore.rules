rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    match /stats/global {
      allow read: if true;
      allow write: if true; 
    }

    match /submissions/{submissionId} {
      allow create: if true;
      allow read: if true;
    }

    match /downloads/{downloadId} {
      allow create: if true;
      allow read: if false;
    }
  }
}
